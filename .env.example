# Local development placeholders only. Never reuse these credentials elsewhere.
# These endpoints are for host commands. Compose sets internal service URLs.
DATABASE_URL=postgresql+psycopg://visionguard:local-dev-only@localhost:5432/visionguard
REDIS_URL=redis://localhost:6379/0
# SeaweedFS S3 API; Compose generates its identity from the keys below.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=visionguard-local
S3_SECRET_KEY=local-dev-only
S3_BUCKET=visionguard
S3_REGION=us-east-1
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=10485760
